{
  "name": "kwilos.js",
  "version": "0.9.0",
  "description": "An easy-to-use, dependency-free, entity-based JavaScript graphics toolkit for HTML5 Canvas",
  "keywords": [
    "canvas",
    "graphics",
    "2d",
    "game-loop",
    "html5",
    "javascript"
  ],
  "homepage": "https://nogginly.github.io/kwilos.js/",
  "bugs": {
    "url": "https://github.com/nogginly/kwilos.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nogginly/kwilos.js.git"
  },
  "license": "MPL-2.0",
  "author": "nogginly",
  "type": "module",
  "exports": {
    ".": {
      "types": "./_dist/types/kwilos.d.ts",
      "default": "./_dist/kwilos.min.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "_dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test-browser": "node site/build.js --from-src && playwright test",
    "typecheck": "tsc",
    "clean": "node -e \"fs.rmSync('_dist', { recursive: true, force: true })\"",
    "build-esm": "esbuild --format=esm --bundle src/kwilos.js  --outfile=_dist/kwilos.mjs",
    "build-esm-min": "esbuild --format=esm --bundle --minify --sourcemap src/kwilos.js --outfile=_dist/kwilos.min.mjs",
    "build-types": "tsc -p tsconfig.build.json",
    "build": "npm run clean && npm run build-esm && npm run build-esm-min && npm run build-types",
    "build-site": "node site/build.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}

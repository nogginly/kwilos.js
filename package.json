{
  "name": "kwilos.js",
  "version": "0.7.0",
  "description": "kwilos.js is an easy-to-use entity-based Javascript graphics toolkit for use with HTML5 Canvas",
  "keywords": [
    "Javascript",
    "Graphics",
    "ECS"
  ],
  "homepage": "https://github.com/nogginly/kwilos.js",
  "bugs": {
    "url": "https://github.com/nogginly/kwilos.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nogginly/kwilos.js.git"
  },
  "license": "MPL-2.0",
  "author": "nogginly",
  "type": "module",
  "exports": {
    ".": {
      "types": "./_dist/types/kwilos.d.ts",
      "default": "./_dist/kwilos.min.mjs"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test-browser": "playwright test",
    "typecheck": "tsc",
    "build-esm": "esbuild --format=esm --bundle src/kwilos.js  --outfile=_dist/kwilos.mjs",
    "build-esm-min": "esbuild --format=esm --bundle --minify --sourcemap src/kwilos.js --outfile=_dist/kwilos.min.mjs",
    "build-types": "tsc -p tsconfig.build.json",
    "build": "npm run build-esm && npm run build-esm-min && npm run build-types"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
